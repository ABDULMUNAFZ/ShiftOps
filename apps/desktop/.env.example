# GitHub integration. Copy to apps/desktop/.env (git-ignored).
# The OAuth client ID is not a secret; ShiftOps uses the Device Authorization
# Flow and never needs a client secret. Leave it empty to use only a
# fine-grained personal access token.
VITE_GITHUB_OAUTH_CLIENT_ID=
VITE_GITHUB_HOST=https://github.com
VITE_GITHUB_API_BASE_URL=https://api.github.com
