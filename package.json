{
  "name": "shiftops",
  "private": true,
  "description": "Define the change once. Ship it everywhere.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "type": "module",
  "scripts": {
    "dev:desktop": "pnpm --filter @shiftops/desktop tauri dev",
    "dev:web": "pnpm --filter @shiftops/desktop dev",
    "dev:website": "pnpm --filter @shiftops/website dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm fmt:rust && pnpm test:rust && pnpm lint:rust",
    "validate:record": "node scripts/record-validation.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
